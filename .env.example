# Build configuration. Copy this file to `.env` (ignored by git) and fill it in.
# The values are compiled into the app with `--dart-define-from-file=.env`.

# Client ID of the Azure app used for the Microsoft login. Required.
MS_CLIENT_ID=

# Redirect URI registered in that Azure app. Optional: defaults to http://127.0.0.1
# MS_REDIRECT_URL=http://127.0.0.1